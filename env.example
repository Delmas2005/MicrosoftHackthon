# Copy this file to .env and fill in the values from the Azure portal.
# Never commit .env (it is in .gitignore).

# Microsoft Foundry (Azure OpenAI endpoint of the Foundry resource)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
MODEL_FAST=gpt-4.1-mini
MODEL_STRONG=gpt-5-mini

# Azure AI Search (Laws of the Game index)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=laws-of-the-game

# Azure Web PubSub (live cards to the screens)
WEBPUBSUB_CONNECTION_STRING=
WEBPUBSUB_HUB=fourth_official

# Azure Storage static website (web/deploy.py)
STORAGE_CONNECTION_STRING=

# Azure AI Speech, free tier F0 (web/build_audio.py, video/voiceover.py)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

# Application Insights, for the traces of every agent (optional; Foundry > Tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Foundry project endpoint, only for `py -m evals.groundedness --to-foundry`
FOUNDRY_PROJECT_ENDPOINT=
